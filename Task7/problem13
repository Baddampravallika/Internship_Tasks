# problem name: Sherlock and the Valid String
# https://www.hackerrank.com/challenges/sherlock-and-valid-string/problem

#!/bin/python3

import os
from collections import Counter

def isValid(s):
    freq = Counter(s)
    counts = Counter(freq.values())

    if len(counts) == 1:
        return "YES"

    if len(counts) != 2:
        return "NO"

    frequencies = sorted(counts.items())

    (f1, c1), (f2, c2) = frequencies

    # One character occurs once and can be removed
    if f1 == 1 and c1 == 1:
        return "YES"

    # One character occurs one extra time
    if f2 == f1 + 1 and c2 == 1:
        return "YES"

    return "NO"


if __name__ == '__main__':
    s = input().strip()
    result = isValid(s)
    print(result)
