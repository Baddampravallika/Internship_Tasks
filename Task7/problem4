# problem name: Funny String
# https://www.hackerrank.com/challenges/funny-string/problem
def funnyString(s):
    r = s[::-1]

    for i in range(len(s) - 1):
        a = abs(ord(s[i + 1]) - ord(s[i]))
        b = abs(ord(r[i + 1]) - ord(r[i]))

        if a != b:
            return "Not Funny"

    return "Funny"


q = int(input())

for _ in range(q):
    s = input().strip()
    print(funnyString(s))
