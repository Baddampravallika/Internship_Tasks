# problem name: Two Strings
# https://www.hackerrank.com/challenges/two-strings/problem

def twoStrings(s1, s2):
    if set(s1) & set(s2):
        return "YES"
    else:
        return "NO"


if __name__ == '__main__':
    q = int(input().strip())

    for _ in range(q):
        s1 = input().strip()
        s2 = input().strip()

        result = twoStrings(s1, s2)
        print(result)
