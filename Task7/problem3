# Mars Exploration
# https://www.hackerrank.com/challenges/mars-exploration/problem
def marsExploration(s):
    count = 0
    original = "SOS" * (len(s) // 3)

    for i in range(len(s)):
        if s[i] != original[i]:
            count += 1

    return count


if __name__ == '__main__':
    s = input().strip()
    result = marsExploration(s)
    print(result)
